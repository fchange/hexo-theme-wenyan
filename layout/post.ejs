<%
  var tocTitle = (theme.labels && theme.labels.table_of_contents) || __('table_of_contents');
  var backToTop = (theme.labels && theme.labels.back_to_top) || __('back_to_top');
  var tocHtml = '';
  if (page.toc === undefined ? theme.toc : page.toc) {
    tocHtml = toc(page.content, { list_number: false, max_depth: 3 });
  }
  var hasToc = tocHtml && tocHtml.indexOf('<ol') !== -1;
%>
<section class="post-shell<%= !hasToc ? ' post-shell-no-toc' : '' %>">
  <article class="post-article<%= !hasToc ? ' post-article-centered' : '' %>">
    <header class="post-header">
      <%- partial('_partial/post/title', {item: page, index: false}) %>
      <%- partial('_partial/post/meta', {item: page, compact: false}) %>
    </header>

    <div class="post-content">
      <%- page.content %>
    </div>

    <%- partial('_partial/post/comment', {item: page}) %>
  </article>

  <% if (hasToc) { %>
    <aside class="post-sidebar">
      <div class="post-sidebar-inner">
        <div class="post-toc"><%- tocHtml %></div>
        <a class="back-top-link" href="#top" aria-label="<%= backToTop %>" title="<%= backToTop %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        </a>
      </div>
    </aside>
  <% } %>
</section>
