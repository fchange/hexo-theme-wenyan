<%- partial('_partial/head') %>
<%
  var headerMotion = !theme.motion || theme.motion.header_expand !== false;
  var motionDuration = (theme.motion && Number(theme.motion.duration)) || 500;
%>
<body class="<%= page.layout === 'post' ? 'is-post' : 'is-page' %><%= headerMotion ? ' has-header-motion' : '' %>" style="--header-motion-duration: <%= motionDuration %>ms">
  <a id="top"></a>
  <div class="site-shell">
    <%- partial('_partial/navigator') %>
    <div class="site-main">
      <%- body %>
    </div>
    <%- partial('_partial/footer') %>
  </div>
  <%- partial('_partial/after_footer') %>
</body>
</html>
