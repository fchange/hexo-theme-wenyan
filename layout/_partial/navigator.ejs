<%
  var navigation = theme.navigation_items || theme.navigation || theme.menu || { '文章': '/', '归档': '/archives/' };
  var social = theme.social_items || theme.social || theme.more || {};
  function resolveLink(link) {
    if (!link) return '#';
    return /^(?:[a-z]+:)?\/\//i.test(link) || /^mailto:/i.test(link) ? link : url_for(link);
  }
  function eachLink(items, callback) {
    if (Array.isArray(items)) {
      items.forEach(function(item) {
        callback(item.label || item.name || item.title, item.link || item.url || item.href);
      });
      return;
    }
    for (var label in items) {
      callback(label, items[label]);
    }
  }
  function iconFor(label, link) {
    var value = ((label || '') + ' ' + (link || '')).toLowerCase();
    if (/github/.test(value)) return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 2a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4M8 19c-3 .9-3-1.5-4-2"/></svg>';
    if (/rss|atom/.test(value)) return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>';
    if (/archive|archives|归档/.test(value)) return '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v12h14V8M10 12h4"/></svg>';
    if (/friend|friends|友链/.test(value)) return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg>';
    if (/photo|photos|gallery|相册/.test(value)) return '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>';
    if (/about|关于/.test(value)) return '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>';
    return '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>';
  }
%>
<header class="site-header">
  <div class="site-header-inner">
    <button class="mobile-menu-button" type="button" aria-label="Toggle menu" aria-controls="mobile-navigation" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
    <a class="site-brand" href="<%- url_for('/') %>" aria-label="<%= _p('home') %>" title="<%= _p('home') %>">
      <svg class="pen-logo" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M8.2 24.7 5.8 26l1.3-2.4L21.8 8.9l1.1-.3 1.8 1.8-.3 1.1Z"/>
        <path d="m19.8 10.9 3.8 3.8M8.2 24.7l-1.1-1.1M22.9 8.6l1.6-1.6a1.8 1.8 0 0 1 2.5 0l.9.9a1.8 1.8 0 0 1 0 2.5l-1.6 1.6"/>
        <path d="M6 28h20"/>
      </svg>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <% eachLink(navigation, function(label, link) { %>
        <a href="<%- resolveLink(link) %>"><span class="nav-icon"><%- iconFor(label, link) %></span><span><%= _p(label) %></span></a>
      <% }) %>
    </nav>

    <div class="site-social">
      <% eachLink(social, function(label, link) { %>
        <a class="icon-link" href="<%- resolveLink(link) %>" aria-label="<%= label %>" title="<%= label %>"><%- iconFor(label, link) %></a>
      <% }) %>
      <% if (theme.search && theme.search.enabled) { %>
        <button class="search-toggle" type="button" aria-label="<%= __('search') %>" title="<%= __('search') %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        </button>
      <% } %>
      <button class="theme-toggle" type="button" aria-label="<%= __('dark_theme') %>" title="<%= __('dark_theme') %>">
        <svg class="theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-menu-backdrop" hidden></div>
  <nav class="mobile-navigation" id="mobile-navigation" aria-label="Mobile navigation" aria-hidden="true">
    <button class="mobile-menu-close" type="button" aria-label="Close menu">×</button>
    <% eachLink(navigation, function(label, link) { %>
      <a href="<%- resolveLink(link) %>"><span class="nav-icon"><%- iconFor(label, link) %></span><span><%= _p(label) %></span></a>
    <% }) %>
  </nav>
  <%- partial('_partial/search') %>
</header>
