<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <%
    var pageTitle = config.title;
    if (page.current > 1) pageTitle = __('page', page.current);
    else if (page.title) pageTitle = page.title;
    else if (page.category) pageTitle = page.category;
    else if (page.tag) pageTitle = page.tag;
    else if (page.archive) {
      if (page.year) pageTitle = page.year + (page.month ? '/' + page.month : '');
      else pageTitle = __('archive_title');
    }

    var fullTitle = pageTitle === config.title ? config.title : pageTitle + ' | ' + config.title;
    var description = '';
    if (page.description) description = page.description;
    else if (page.excerpt) description = strip_html(page.excerpt).replace(/\s+/g, ' ').trim();
    else if (page.content) description = strip_html(page.content).replace(/\s+/g, ' ').trim().substring(0, 150);
    else if (config.description) description = config.description;

    var keywords = Array.isArray(config.keywords) ? config.keywords.join(', ') : config.keywords;
    var accentPresets = {
      cinnabar: '#b33a2b',
      pine: '#2f6b57',
      indigo: '#3f5f8a'
    };
    var accentConfig = theme.accent || {};
    var accentPreset = accentConfig.preset || 'cinnabar';
    var customAccent = typeof accentConfig === 'string' ? accentConfig : accentConfig.color;
    var accentColor = /^#[0-9a-f]{6}$/i.test(customAccent || '')
      ? customAccent
      : (accentPresets[accentPreset] || accentPresets.cinnabar);
  %>
  <title><%= fullTitle %></title>
  <% if (config.author) { %><meta name="author" content="<%= config.author %>"><% } %>
  <% if (description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (keywords) { %><meta name="keywords" content="<%= keywords %>"><% } %>
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:title" content="<%= fullTitle %>">
  <% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
  <meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
  <link rel="icon" type="image/x-icon" href="<%- url_for('/favicon.ico') %>">
  <link rel="alternate" href="<%- url_for('/atom.xml') %>" title="<%= config.title %>" type="application/atom+xml">
  <link rel="alternate" href="<%- url_for('/rss.xml') %>" title="<%= config.title %>" type="application/rss+xml">
  <script>
    (function () {
      var saved = null;
      try { saved = localStorage.getItem('wenyan-theme'); } catch (error) {}
      if (!saved) {
        var match = document.cookie.match(/(?:^|; )wenyan-theme=(light|dark)/);
        saved = match && match[1];
      }
      var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    })();
  </script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-lite-webfont@1.1.0/style.css">
  <link rel="stylesheet" href="<%- url_for('/css/theme.css') %>">
  <style>:root { --accent-source: <%= accentColor %>; }</style>
  <% if (theme.latex) { %><script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.5/MathJax.js?config=TeX-MML-AM_CHTML" async></script><% } %>
</head>
