<%
  var commentsEnabled = item.comments !== false;
  var valineEnabled = theme.valine && theme.valine.enable;
  var disqusEnabled = config.disqus_shortname;
%>
<% if (commentsEnabled && (disqusEnabled || valineEnabled)) { %>
  <section class="comments" aria-labelledby="comments-title">
    <h2 id="comments-title"><%= __('comments') %></h2>
    <% if (disqusEnabled) { %>
      <div id="disqus_thread"></div>
      <script>
        var disqus_config = function () {
          this.page.url = <%- JSON.stringify(full_url_for(item.path)) %>;
          this.page.identifier = <%- JSON.stringify(item.path) %>;
        };
        (function () {
          var script = document.createElement('script');
          script.src = 'https://<%- config.disqus_shortname %>.disqus.com/embed.js';
          script.setAttribute('data-timestamp', String(Date.now()));
          (document.head || document.body).appendChild(script);
        })();
      </script>
    <% } else { %>
      <div id="vcomment"></div>
      <script src="https://cdn.jsdelivr.net/npm/leancloud-storage@4/dist/av-min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/valine/dist/Valine.min.js"></script>
      <script>
        new Valine({
          el: '#vcomment',
          appId: <%- JSON.stringify(theme.valine.appId || '') %>,
          appKey: <%- JSON.stringify(theme.valine.appKey || '') %>,
          placeholder: <%- JSON.stringify(theme.valine.placeholder || '') %>,
          pageSize: <%= Number(theme.valine.pageSize) || 10 %>,
          avatar: <%- JSON.stringify(theme.valine.avatar || 'mm') %>,
          lang: <%- JSON.stringify(theme.valine.lang || 'en') %>,
          meta: <%- JSON.stringify((theme.valine.guest_info || 'nick,mail,link').split(',').filter(Boolean)) %>,
          notify: <%= theme.valine.notify === true %>,
          verify: <%= theme.valine.verify === true %>,
          visitor: false
        });
      </script>
    <% } %>
  </section>
<% } %>
