<%
  var compact = typeof compact !== 'undefined' ? compact : false;
  var plainContent = strip_html(item.content || '').replace(/\s+/g, '');
  var categories = item.categories ? item.categories.toArray() : [];
  var tags = item.tags ? item.tags.toArray() : [];
%>
<div class="post-meta<%= compact ? ' post-meta-compact' : '' %>">
  <time datetime="<%= date_xml(item.date) %>"><%= item.date.format(config.date_format) %></time>
  <% if (plainContent.length) { %><span aria-hidden="true">·</span><span><%= plainContent.length %> <%= __('word_count') %></span><% } %>
  <% if (!compact && categories.length) { %>
    <span aria-hidden="true">·</span>
    <span class="post-taxonomy" aria-label="<%= __('categories') %>">
      <% categories.forEach(function(category, index) { %><% if (index) { %><span>, </span><% } %><a href="<%- url_for(category.path) %>"><%= category.name %></a><% }); %>
    </span>
  <% } %>
  <% if (!compact && tags.length) { %>
    <span aria-hidden="true">·</span>
    <span class="post-taxonomy post-tags" aria-label="<%= __('tags') %>">
      <% tags.forEach(function(tag) { %><a href="<%- url_for(tag.path) %>">#<%= tag.name %></a><% }); %>
    </span>
  <% } %>
  <% if (!compact && theme.stats && theme.stats.busuanzi) { %>
    <span class="post-views" id="busuanzi_container_page_pv" style="display: none"><span aria-hidden="true">·</span> <span id="busuanzi_value_page_pv"></span> <%= __('page_views') %></span>
  <% } %>
</div>
